# Copy to .env. Never commit real credentials. Process environment takes precedence.
PI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# PI_MODEL=
# Alternative provider:
# PI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# Google is optional; enable the APIs and configure OAuth before connecting.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8767/api/connectors/google/callback
